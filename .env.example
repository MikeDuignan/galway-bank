# Galway Mutual — environment template. Copy to .env and edit. The real .env is gitignored.

# SQLite database file. In Docker compose this lives on a named volume.
GALWAY_BANK_DB=/var/lib/galway-bank/bank.db

# Flask session signing key. MUST be set in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me-please-this-is-only-for-dev
